# ---------------------------------------------------------------------------
# Supabase (required)
# ---------------------------------------------------------------------------
# Public — safe to expose to the browser. Found in Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — NEVER prefix with NEXT_PUBLIC_, never import in client components.
# Used only in: scripts/*.ts, src/app/api/**/route.ts (server runtime).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# App identity (configurable branding — do not hardcode "METRO" in code)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="METRO Fit Team"
NEXT_PUBLIC_DEFAULT_LOCALE=de

# ---------------------------------------------------------------------------
# Initial admin bootstrap (server-only — see "Initial admin bootstrap" in README.md)
# ---------------------------------------------------------------------------
INITIAL_ADMIN_EMAIL=thorsten.roloff@metro-logistics.de
INITIAL_TEAM_NAME="METRO Marl Fitness Team"

# ---------------------------------------------------------------------------
# App URL (used to build absolute invite links / QR codes)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Web Push (optional — chat push notifications are disabled if unset).
# Generate a pair with: npx web-push generate-vapid-keys
# ---------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
